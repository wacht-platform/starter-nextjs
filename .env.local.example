# Wacht keys. Prefer `wacht env pull` to populate `.env.local`.
# Public key is shipped to the browser.
NEXT_PUBLIC_WACHT_PUBLISHABLE_KEY=pk_test_xxx

# Server-only deployment API key and backend URL for @wacht/backend calls.
WACHT_API_KEY=sk_test_xxx
WACHT_BACKEND_API_URL=https://example.fapi.trywacht.xyz
